# Server Configuration
PORT=3000            # Port number for the server
HOST=localhost       # Use '0.0.0.0' to give LAN/internet access
NODE_ENV=development # 'development' | 'production'. Development debuggs, production keeps console clean
# PUBLIC_URL="https://yourdomain.tld" # The public base URL of your CinePro Core instance. Use this when your server is exposed through a public hostname, reverse proxy, or domain. NO TRAILING SLASH.
STREMIO_ADDON=false  # Set to 'true' to enable Stremio addon functionality. Usage: host:port/stremio/manifest.json
CORS_ORIGIN="*"      # CORS origin for the server. Set to '*' to allow all origins, or a specific origin (e.g., 'http://example.com')
MCP_ENABLED=false    # Set to 'true' to enable MCP functionality
INTERNAL_DEBUG=false # Set to 'true' to get non-playable sources too. recommended: false

# Optional CinePro-owned provider-health persistence. Configure one fixed
# dedicated directory; never place it in recordings, public state, or a release checkout.
# CINEPRO_PROVIDER_HEALTH_DIR=/var/lib/cinepro/provider-health

# Optional private provider recheck listener. The listener is disabled unless a
# unique, whitespace-free token of 32-256 bytes is configured. Keep its
# port on a private service network; never publish it to the host or internet.
# CINEPRO_INTERNAL_RECHECK_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes
# CINEPRO_INTERNAL_RECHECK_HOST=127.0.0.1
# CINEPRO_INTERNAL_RECHECK_PORT=3011
# CINEPRO_INTERNAL_RECHECK_CONCURRENCY=4
# CINEPRO_HEALTH_RESOLVER_TIMEOUT_MS=20000

# Provider controls use exact canonical catalog IDs. Blank lists preserve
# catalog defaults. A nonempty allowlist disables unmatched identities; a deny
# always wins. Empty members, duplicates, and unknown IDs fail startup closed.
# CINEPRO_PROVIDER_FAMILY_ALLOWLIST=tulnex
# CINEPRO_PROVIDER_FAMILY_DENYLIST=ezvidapi
# CINEPRO_PROVIDER_LEAF_ALLOWLIST=tulnex:onion
# CINEPRO_PROVIDER_LEAF_DENYLIST=tulnex:vidzee
# CINEPRO_PROVIDER_HOST_ALLOWLIST=streamwish
# CINEPRO_PROVIDER_HOST_DENYLIST=vidfast
#
# EzVidAPI remains off until authorized seeds pass certification.
EZVIDAPI_ENABLED=false

# Optional VixSrc custom origin registered through vixsrc.to. This is useful
# when the public origin blocks server-side requests from your deployment.
# Use a dedicated domain/subdomain whose DNS ownership and nameserver
# delegation are approved; do not point this at an unrelated mirror.
# VIXSRC_BASE_URL=https://video.example.com

# TMDB Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_CACHE_TTL=86400

# Cache Configuration
CACHE_TYPE=memory    # 'memory' | 'redis'
LIVE_MANIFEST_CACHE_TTL=21600 # 6 hours; keep high to conserve API-Sports requests
LIVE_SOURCE_CACHE_TTL=30      # Live source URLs should stay short-lived

# Live Event Discovery
# OpenF1 and NHL Web are enabled by default. They provide schedule metadata only;
# source lookup still depends on authorized source maps or watch-page resolution.
OPENF1_ENABLED=true
OPENF1_CACHE_TTL_SECONDS=21600
OPENF1_LOOKAHEAD_DAYS=14
OPENF1_LOOKBACK_HOURS=12
# OPENF1_SESSION_TYPES=Practice,Qualifying,Race
# OPENF1_WATCH_PAGES=https://methstreams.ms/league/f1streams,https://streameastv1.com/schedule/f1
OPENF1_WATCH_SOURCE_RESOLUTION_ENABLED=true
OPENF1_WATCH_MATCH_MIN_SCORE=0.45
OPENF1_WATCH_PAGE_CACHE_TTL_SECONDS=60
OPENF1_WATCH_SOURCE_CACHE_TTL_SECONDS=30
# OPENF1_HEADLESSVIDX_BASE_URL=http://headlessvidx:3202

NHLWEB_ENABLED=true
NHLWEB_CACHE_TTL_SECONDS=900
NHLWEB_LOOKAHEAD_DAYS=14
NHLWEB_LOOKBACK_HOURS=12
NHLWEB_EVENT_DURATION_MINUTES=180
# NHLWEB_GAME_TYPES=2,3
# NHLWEB_WATCH_PAGES=https://methstreams.ms/league/nhlstreams,https://streameastv1.com/schedule/nhl
NHLWEB_WATCH_SOURCE_RESOLUTION_ENABLED=true
NHLWEB_WATCH_MATCH_MIN_SCORE=0.45
NHLWEB_WATCH_PAGE_CACHE_TTL_SECONDS=60
NHLWEB_WATCH_SOURCE_CACHE_TTL_SECONDS=30
# NHLWEB_HEADLESSVIDX_BASE_URL=http://headlessvidx:3202

APISPORTS_ENABLED=false
APISPORTS_KEY=your_api_sports_key_here
APISPORTS_CACHE_TTL_SECONDS=21600
APISPORTS_DAILY_REQUEST_BUDGET=24
APISPORTS_LOOKAHEAD_DAYS=14
APISPORTS_LOOKBACK_HOURS=12

# Formula 1
APISPORTS_F1_ENABLED=true
APISPORTS_F1_SEASON=2026
# APISPORTS_F1_TYPES=Race,Sprint
# APISPORTS_F1_WATCH_PAGES=https://methstreams.ms/league/f1streams,https://streameastv1.com/schedule/f1

# NHL
APISPORTS_HOCKEY_ENABLED=true
APISPORTS_HOCKEY_NHL_LEAGUE_ID=57
APISPORTS_HOCKEY_NHL_SEASON=2025
# APISPORTS_NHL_WATCH_PAGES=https://methstreams.ms/league/nhlstreams,https://streameastv1.com/schedule/nhl

# Optional pages to append to every API-Sports event's lookup list. Useful for DaddyLive.
# APISPORTS_COMMON_WATCH_PAGES=https://example.com/match-schedule/
APISPORTS_WATCH_SOURCE_RESOLUTION_ENABLED=true
APISPORTS_WATCH_MATCH_MIN_SCORE=0.45
APISPORTS_WATCH_PAGE_CACHE_TTL_SECONDS=60
APISPORTS_WATCH_SOURCE_CACHE_TTL_SECONDS=30
# APISPORTS_HEADLESSVIDX_BASE_URL=http://headlessvidx:3202
# APISPORTS_WATCH_RENDER_WITH_PLAYWRIGHT=false

# Movie/TV embed extraction. When configured, embed providers return a
# HeadlessVidX HLS candidate first and keep the iframe embed as fallback.
# EMBED_HEADLESSVIDX_ENABLED=true
# EMBED_HEADLESSVIDX_BASE_URL=http://headlessvidx:3202

# Generic watch-page matching. Point WATCHPAGE_URL at any page with event/watch links.
# Matching saves discovered watch hrefs on the live event candidate, then optional
# source resolution sends those hrefs through HeadlessVidX /play URLs.
WATCHPAGE_ENABLED=false
WATCHPAGE_DISCOVERY_ENABLED=false
WATCHPAGE_URL=https://example.com/match-schedule/
WATCHPAGE_CACHE_TTL_SECONDS=900
WATCHPAGE_MATCH_MIN_SCORE=0.45
WATCHPAGE_MATCH_TIME_WINDOW_HOURS=18
WATCHPAGE_HREF_PATTERNS=watch.php?id=,/watch,/stream,/embed,/play
WATCHPAGE_RENDER_WITH_PLAYWRIGHT=false
WATCHPAGE_SOURCE_RESOLUTION_ENABLED=false
WATCHPAGE_HEADLESSVIDX_BASE_URL=http://headlessvidx:3202
WATCHPAGE_SOURCE_CACHE_TTL_SECONDS=30
# WATCHPAGE_EVENT_ROW_SELECTOR=.event-row
# WATCHPAGE_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# WATCHPAGE_PLAYWRIGHT_PACKAGE=playwright-core

# Backward-compatible DaddyLive aliases.
DADDYLIVE_ENABLED=false
DADDYLIVE_DISCOVERY_ENABLED=false
DADDYLIVE_SCHEDULE_URL=https://example.com/match-schedule/
DADDYLIVE_SCHEDULE_CACHE_TTL_SECONDS=900
DADDYLIVE_MATCH_MIN_SCORE=0.45
DADDYLIVE_MATCH_TIME_WINDOW_HOURS=18
DADDYLIVE_WATCH_HREF_PATTERNS=watch.php?id=
DADDYLIVE_RENDER_WITH_PLAYWRIGHT=false
DADDYLIVE_SOURCE_RESOLUTION_ENABLED=false
DADDYLIVE_HEADLESSVIDX_BASE_URL=http://headlessvidx:3202
DADDYLIVE_SOURCE_CACHE_TTL_SECONDS=30
# DADDYLIVE_EVENT_ROW_SELECTOR=.event-row
# DADDYLIVE_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# DADDYLIVE_PLAYWRIGHT_PACKAGE=playwright-core

# Optional authorized live source map. This file is local and should not be committed.
# LIVE_AUTHORIZED_SOURCE_MAP_PATH=/absolute/path/to/live-sources.json

# Redis Configuration (if using Redis cache)
REDIS_HOST=localhost # default Redis host
REDIS_PORT=6379      # default Redis port
REDIS_PASSWORD=      # Redis password if required
