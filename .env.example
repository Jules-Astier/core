# Server Configuration
PORT=3000            # Port number for the server
HOST=localhost       # Use '0.0.0.0' to give LAN/internet access
NODE_ENV=development # 'development' | 'production'. Development debuggs, production keeps console clean
# PUBLIC_URL="https://yourdomain.tld" # The public base URL of your CinePro Core instance. Use this when your server is exposed through a public hostname, reverse proxy, or domain. NO TRAILING SLASH.
STREMIO_ADDON=false  # Set to 'true' to enable Stremio addon functionality. Usage: host:port/stremio/manifest.json
CORS_ORIGIN="*"      # CORS origin for the server. Set to '*' to allow all origins, or a specific origin (e.g., 'http://example.com')
MCP_ENABLED=false    # Set to 'true' to enable MCP functionality
INTERNAL_DEBUG=false # Set to 'true' to get non-playable sources too. recommended: false

# TMDB Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_CACHE_TTL=86400

# Cache Configuration
CACHE_TYPE=memory    # 'memory' | 'redis'
LIVE_MANIFEST_CACHE_TTL=21600 # 6 hours; keep high to conserve API-Sports requests
LIVE_SOURCE_CACHE_TTL=30      # Live source URLs should stay short-lived

# Live Event Discovery
APISPORTS_ENABLED=false
APISPORTS_KEY=your_api_sports_key_here
APISPORTS_CACHE_TTL_SECONDS=21600
APISPORTS_DAILY_REQUEST_BUDGET=24
APISPORTS_LOOKAHEAD_DAYS=14
APISPORTS_LOOKBACK_HOURS=12

# Formula 1
APISPORTS_F1_ENABLED=true
APISPORTS_F1_SEASON=2026

# NHL
APISPORTS_HOCKEY_ENABLED=true
APISPORTS_HOCKEY_NHL_LEAGUE_ID=57
APISPORTS_HOCKEY_NHL_SEASON=2025

# DaddyLive schedule matching. This stores watch-page hrefs as metadata only.
DADDYLIVE_ENABLED=false
DADDYLIVE_DISCOVERY_ENABLED=false
DADDYLIVE_SCHEDULE_URL=https://example.com/match-schedule/
DADDYLIVE_SCHEDULE_CACHE_TTL_SECONDS=900
DADDYLIVE_MATCH_MIN_SCORE=0.45
DADDYLIVE_MATCH_TIME_WINDOW_HOURS=18
DADDYLIVE_WATCH_HREF_PATTERNS=watch.php?id=
DADDYLIVE_RENDER_WITH_PLAYWRIGHT=false
# DADDYLIVE_EVENT_ROW_SELECTOR=.event-row
# DADDYLIVE_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional authorized live source map. This file is local and should not be committed.
# LIVE_AUTHORIZED_SOURCE_MAP_PATH=/absolute/path/to/live-sources.json

# Redis Configuration (if using Redis cache)
REDIS_HOST=localhost # default Redis host
REDIS_PORT=6379      # default Redis port
REDIS_PASSWORD=      # Redis password if required
